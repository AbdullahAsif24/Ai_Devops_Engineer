# Copy this file to `.env.local` and fill in the values.
# Vite only exposes vars prefixed with VITE_ to the frontend.
# NOTE: restart the dev server after changing env vars — Vite reads them at startup.

# Backend base URL — FastAPI server
# Leave BLANK to run the frontend in mock mode (no backend needed).
VITE_API_BASE_URL=http://127.0.0.1:8000

# Force mock mode even when VITE_API_BASE_URL is set (optional): true | false
VITE_USE_MOCK=false
