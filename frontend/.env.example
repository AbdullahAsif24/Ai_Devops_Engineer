# Copy this file to `.env.local` for local work. On Vercel, add the same names under
# Project Settings > Environment Variables, then redeploy: Vite bakes these in at build time.

# Backend base URL (FastAPI). Must be https in production, or the browser blocks the calls.
# Leave BLANK to run the frontend in demo mode (no backend, no sign-in).
VITE_API_BASE_URL=http://127.0.0.1:8000

# Force demo mode even when VITE_API_BASE_URL is set: true | false
VITE_USE_MOCK=false

# Supabase project that handles "Continue with GitHub". The URL is public.
VITE_SUPABASE_URL=https://ioxdvfqvpexdkoidgjrl.supabase.co

# Optional. Public anon key; lets expired sessions refresh quietly instead of signing people out.
VITE_SUPABASE_ANON_KEY=
