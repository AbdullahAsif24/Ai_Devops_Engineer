# Copy this file to `.env` and fill in your key. Never commit `.env`.
GROQ_API_KEY=your_groq_api_key_here

# Optional tuning (defaults shown)
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_TEMPERATURE=0.1
# MAX_HEAL_RETRIES=3

# Supabase configuration for authentication and database
SUPABASE_URL=https://ioxdvfqvpexdkoidgjrl.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# OAuth callback URLs (update with your actual domain)
VERCEL_OAUTH_CALLBACK_URL=http://localhost:8000/oauth/vercel/callback
RENDER_OAUTH_CALLBACK_URL=http://localhost:8000/oauth/render/callback

# OAuth app credentials (create these in Vercel/Render developer portals)
VERCEL_CLIENT_ID=your_vercel_client_id
VERCEL_CLIENT_SECRET=your_vercel_client_secret
RENDER_CLIENT_ID=your_render_client_id
RENDER_CLIENT_SECRET=your_render_client_secret